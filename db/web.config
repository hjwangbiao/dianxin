<?xml version="1.0" encoding="UTF-8"?>
<!--
  数据库目录保护（IIS）：
  1. 禁止 .mdb 文件被直接 HTTP 下载；
  2. 若服务器支持 ASP.NET，整目录拒绝匿名访问。
  仅在 IIS 站点上生效；传统 ASP 虚拟主机请在主机面板里为该目录
  设置「禁止 HTTP 直接下载」，或把 db 移到站点根目录之外的任意位置，
  并同步修改 feedback-db.asp 里的 MapPath 路径。
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".mdb" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <staticContent>
    </staticContent>
  </system.webServer>
</configuration>
